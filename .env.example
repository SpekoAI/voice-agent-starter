# Required. Your Speko API key - create one at https://platform.speko.dev/api-keys
# Keys start with sk_live_. This is read server-side only (app/api/session/route.ts)
# and is never sent to the browser.
SPEKO_API_KEY=sk_live_replace_with_your_key

# Optional. Drive calls from a saved agent (prompt, voice, and routing configured
# in the dashboard at https://platform.speko.dev/agents) instead of the inline
# defaults in app/api/session/route.ts.
# SPEKO_AGENT_ID=

# Optional. Override the Speko API base URL. Defaults to production.
# SPEKO_API_BASE=https://api.speko.dev
